# Copy to .env.local and fill in. Never commit .env.local.
# Phase 0 only needs the site settings; the rest are filled in as phases land.

# --- Site (src/config/site.ts) ---
NEXT_PUBLIC_SITE_NAME=Distortion
NEXT_PUBLIC_SITE_TAGLINE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EMAIL_FROM=Distortion <noreply@example.com>
# Shown on the Terms, Privacy and About pages for reports and privacy requests. Set before launch.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Database: Neon Postgres (Phase 1) ---
# Neon dashboard -> Connection details -> copy the pooled connection string
DATABASE_URL=

# --- Auth.js (Phase 2) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The email that gets the 'owner' role on sign-up
OWNER_EMAIL=

# --- Email: Resend (Phase 2) ---
RESEND_API_KEY=

# --- Cloudflare R2 storage (Phase 1) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL for the bucket (custom domain or r2.dev URL)
R2_PUBLIC_URL=

# --- Cloudflare Turnstile (Phase 2) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- MusicBrainz (Phase 1) ---
# Required by MusicBrainz: identify the app and a contact. Use a real contact address.
MUSICBRAINZ_USER_AGENT=YourSiteName/0.1 ( your-contact@example.com )

# --- Background jobs (Phase 1) ---
# Shared secret that Vercel Cron sends to /api/cron/*
CRON_SECRET=

# --- Feature flags (src/features.ts); set to true to enable ---
# FEATURE_LISTS=true
# FEATURE_QUEUE=true
# FEATURE_STATS=true
# FEATURE_SEARCH=true
# FEATURE_ARTIST_PAGES=true
# FEATURE_PLATFORM_LINKS=true
# FEATURE_INSTAGRAM_IMPORT=true

# Optional: Odesli (song.link) API key. Adds Spotify, YouTube Music and Tidal links to album
# pages. Without it, albums still get Deezer and Apple Music links. Odesli returned 401 to
# keyless requests when last tried; request a key from them if you want the extra services.
ODESLI_API_KEY=
